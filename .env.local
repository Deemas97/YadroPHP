# ============ APPLICATION ============
# {dev, test, production}
APP_ENV=dev
APP_NAME=YadroPHP
APP_DEBUG=1
APP_URL=https://yadrophp.local
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru_RU
APP_FALLBACK_LOCALE=en_US
APP_DEFAULT_PIPELINE_ENABLED=1

# ============ SECURITY ============
HTTPS_FORCED=0
SESSION_LIFETIME=3600
SRI_ENABLED=0

# ============ DATABASE ============
DB_CONNECTION=mysql
DB_HOST=***
DB_PORT=3306
DB_DATABASE=***
DB_USERNAME=***
DB_PASSWORD=***
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_STRICT=true

# ============ CACHE & SESSIONS ============
CACHE_DRIVER=file
CACHE_PREFIX=yadro_php_
SESSION_DRIVER=file
SESSION_ENCRYPT=false

# ============ FILES ============
FILESYSTEM_DISK=local
FILESYSTEM_CLOUD=s3
UPLOAD_MAX_SIZE=2048

# ============ LOGGING ============
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============ OPCACHE ============
OPCACHE_PRELOAD_MAX_AGE=3600

# ============ JIT ============
JIT_ENABLED=1
JIT_PROFILE=function
JIT_BUFFER_SIZE=256M
JIT_IN_TESTS=0
JIT_OPTIMIZATION_LEVEL=4
JIT_HOT_FUNC=7
JIT_HOT_LOOP=15
JIT_AUTO_OPTIMIZE=0
JIT_CRON_ENABLED=0
JIT_LOGGING=1

# ============ GZIP ============
GZIP_ENABLED=1
GZIP_COMPRESSION_LEVEL=1
GZIP_IN_TESTS=1

# ============ CUSTOM ============
MAINTENANCE_MODE=1
